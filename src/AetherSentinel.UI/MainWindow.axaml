<Window
    x:Class="AetherSentinel.UI.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AETHER SENTINEL AI"
    Width="1180"
    Height="760"
    MinWidth="1040"
    MinHeight="680"
    Background="#05070A"
    FontFamily="Inter, PingFang SC, Microsoft YaHei, Segoe UI, SF Pro">
  <Window.Resources>
    <SolidColorBrush x:Key="DeepSpaceBrush" Color="#05070A" />
    <SolidColorBrush x:Key="AetherDarkBrush" Color="#0B0F14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#101722" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#121B28" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1C2531" />
    <SolidColorBrush x:Key="BlueBrush" Color="#2F80FF" />
    <SolidColorBrush x:Key="GreenBrush" Color="#2BD576" />
    <SolidColorBrush x:Key="AmberBrush" Color="#F2B84B" />
    <SolidColorBrush x:Key="RedBrush" Color="#FF4D5E" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B3C2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6F7A89" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.navButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.navButton.active">
      <Setter Property="Background" Value="#18283C" />
      <Setter Property="BorderBrush" Value="#294767" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BlueBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#162231" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lang">
      <Setter Property="Background" Value="#101722" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lang.active">
      <Setter Property="Background" Value="#18283C" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="#2F80FF" />
    </Style>
    <Style Selector="Button.coreAction">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="228,*,306" Background="{StaticResource DeepSpaceBrush}">
    <Border Grid.Column="0" Background="{StaticResource AetherDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,22">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="AETHER" FontSize="21" FontWeight="Bold" LetterSpacing="0" />
          <TextBlock Text="SENTINEL AI" FontSize="12" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" />
          <TextBlock x:Name="BrandSubtitleText" Text="Performance Intelligence" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,32,0,0">
          <Button x:Name="NavDashboardButton" Classes="navButton active" Click="OnNavigateClicked" Tag="dashboard" Content="Dashboard" />
          <Button x:Name="NavPcIntelligenceButton" Classes="navButton" Click="OnNavigateClicked" Tag="pc" Content="PC Intelligence" />
          <Button x:Name="NavGameOptimizationButton" Classes="navButton" Click="OnNavigateClicked" Tag="game" Content="Game Optimization" />
          <Button x:Name="NavPerformanceMonitorButton" Classes="navButton" Click="OnNavigateClicked" Tag="monitor" Content="Performance Monitor" />
          <Button x:Name="NavOptimizationCenterButton" Classes="navButton" Click="OnNavigateClicked" Tag="optimization" Content="Optimization Center" />
          <Button x:Name="NavDnsOptimizationButton" Classes="navButton" Click="OnNavigateClicked" Tag="dns" Content="DNS Optimization" />
          <Button x:Name="NavAiAdvisorButton" Classes="navButton" Click="OnNavigateClicked" Tag="advisor" Content="AI Advisor" />
          <Button x:Name="NavHistoryButton" Classes="navButton" Click="OnNavigateClicked" Tag="history" Content="History" />
          <Button x:Name="NavSettingsButton" Classes="navButton" Click="OnNavigateClicked" Tag="settings" Content="Settings" />
        </StackPanel>

        <Border Grid.Row="2" Classes="card" Padding="14">
          <StackPanel Spacing="9">
            <TextBlock x:Name="SystemGuardTitleText" Text="SYSTEM GUARD" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="LocalScanReadyText" Text="Local scan ready" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,22,22,22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitleText" Text="AI-native performance guardian for Windows PCs" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
          <Button x:Name="ZhButton" Classes="lang active" Content="简" Click="OnChineseClicked" />
          <Button x:Name="EnButton" Classes="lang" Content="EN" Click="OnEnglishClicked" />
          <Button x:Name="ScanButton" Classes="secondary" Content="Scan" />
          <Button x:Name="OptimizeButton" Classes="primary" Content="AI Optimize" />
        </StackPanel>
      </Grid>

      <Grid x:Name="MetricsGrid" Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="0,22,0,16">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            <TextBlock Text="82%" FontSize="26" FontWeight="SemiBold" />
            <Border Height="6" CornerRadius="3" Background="#182334" ClipToBounds="True">
              <Border Width="130" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource AmberBrush}" />
            </Border>
            <TextBlock x:Name="CpuStatusText" Text="High load" Foreground="{StaticResource AmberBrush}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="GPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            <TextBlock Text="96%" FontSize="26" FontWeight="SemiBold" />
            <Border Height="6" CornerRadius="3" Background="#182334" ClipToBounds="True">
              <Border Width="152" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource RedBrush}" />
            </Border>
            <TextBlock x:Name="GpuStatusText" Text="Thermal watch" Foreground="{StaticResource RedBrush}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="MEMORY" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            <TextBlock Text="65%" FontSize="26" FontWeight="SemiBold" />
            <Border Height="6" CornerRadius="3" Background="#182334" ClipToBounds="True">
              <Border Width="104" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource BlueBrush}" />
            </Border>
            <TextBlock x:Name="MemoryStatusText" Text="Stable" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="card" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="DISK" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            <TextBlock Text="41%" FontSize="26" FontWeight="SemiBold" />
            <Border Height="6" CornerRadius="3" Background="#182334" ClipToBounds="True">
              <Border Width="66" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource GreenBrush}" />
            </Border>
            <TextBlock x:Name="DiskStatusText" Text="Healthy" Foreground="{StaticResource GreenBrush}" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="DashboardMainGrid" Grid.Row="2" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="16">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel>
              <TextBlock x:Name="CoreTitleText" Text="AI PERFORMANCE CORE" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="87 / 100" FontSize="50" FontWeight="Bold" Margin="0,6,0,0" />
              <TextBlock x:Name="CoreDescriptionText" Text="Performance is strong, but GPU pressure and background load should be watched before gaming sessions." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" MaxWidth="390" />
            </StackPanel>

            <Grid Width="142" Height="142" HorizontalAlignment="Center" Margin="0,2,0,0">
              <Ellipse Stroke="#16283D" StrokeThickness="8" />
              <Ellipse Stroke="{StaticResource BlueBrush}" StrokeThickness="8" StrokeDashArray="5,1.6" StrokeLineCap="Round" />
              <Ellipse Width="94" Height="94" Fill="#0A111B" Stroke="#1C334B" StrokeThickness="1" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="GuardianLabelText" Text="GUARDIAN" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="ActiveStatusText" Text="ACTIVE" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="SafeModeText" Text="Verified Safe Mode" HorizontalAlignment="Center" Foreground="{StaticResource GreenBrush}" FontSize="10" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="18,2,18,0">
              <Button x:Name="AnalyzeButton" Classes="primary coreAction" Content="Analyze Now" />
              <Button x:Name="ReportButton" Grid.Column="1" Classes="secondary coreAction" Content="View Report" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="20">
          <StackPanel Spacing="15">
            <TextBlock x:Name="QueueTitleText" Text="Optimization Queue" FontSize="18" FontWeight="SemiBold" />
            <Border Background="#0B141F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
              <StackPanel Spacing="5">
                <TextBlock x:Name="QueueItemOneTitleText" Text="Reduce startup pressure" FontWeight="SemiBold" />
                <TextBlock x:Name="QueueItemOneBodyText" Text="3 background launch items require review." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
            <Border Background="#0B141F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
              <StackPanel Spacing="5">
                <TextBlock x:Name="QueueItemTwoTitleText" Text="GPU thermal watch" FontWeight="SemiBold" />
                <TextBlock x:Name="QueueItemTwoBodyText" Text="High load detected. No automatic action will run without confirmation." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
            <Border Background="#0B141F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
              <StackPanel Spacing="5">
                <TextBlock x:Name="QueueItemThreeTitleText" Text="Rollback required" FontWeight="SemiBold" />
                <TextBlock x:Name="QueueItemThreeBodyText" Text="Every optimization rule must define backup and rollback before execution." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="TipsCard" Grid.Row="3" Classes="card" Padding="16" Margin="0,16,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="42" Height="42" CornerRadius="8" Background="#16283C">
            <TextBlock Text="AI" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3">
            <TextBlock x:Name="TipsTitleText" Text="AI Tips" FontWeight="SemiBold" />
            <TextBlock x:Name="TipsBodyText" Text="Before enabling optimization, AETHER will explain the bottleneck, risk level, backup method, verification signal, and rollback path." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl x:Name="ModuleContent" Grid.Row="1" Grid.RowSpan="3" IsVisible="False" />
    </Grid>

    <Border Grid.Column="2" Background="#07101A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,22">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel>
          <TextBlock x:Name="FeedTitleText" Text="Sentinel Feed" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="FeedSubtitleText" Text="Live insight preview" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12" Margin="0,22,0,0">
          <Border Classes="card" Padding="15">
            <StackPanel Spacing="8">
              <TextBlock x:Name="CurrentStateTitleText" Text="Current State" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="CurrentStateBodyTitleText" Text="Ready for read-only scan" FontWeight="SemiBold" />
              <TextBlock x:Name="CurrentStateBodyText" Text="No system changes are enabled in this prototype." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="15">
            <StackPanel Spacing="8">
              <TextBlock x:Name="GameSessionTitleText" Text="Game Session" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="GameSessionBodyTitleText" Text="No active game detected" FontWeight="SemiBold" />
              <TextBlock x:Name="GameSessionBodyText" Text="Future versions will detect full-screen gaming sessions before optimization." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="15">
            <StackPanel Spacing="8">
              <TextBlock x:Name="UpdateSystemTitleText" Text="Update System" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="UpdateSystemBodyTitleText" Text="Reserved" FontWeight="SemiBold" />
              <TextBlock x:Name="UpdateSystemBodyText" Text="Version checking, package verification, and rollback are architecture placeholders." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="2" Classes="card" Padding="15">
          <StackPanel Spacing="8">
            <TextBlock x:Name="PhasePreviewTitleText" Text="Phase 01 Preview" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" />
            <TextBlock x:Name="PhasePreviewBodyText" Text="Avalonia shell with simulated performance data." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
